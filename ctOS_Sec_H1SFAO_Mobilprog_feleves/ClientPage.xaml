<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ctOS_Sec_H1SFAO_Mobilprog_feleves"
             x:Class="ctOS_Sec_H1SFAO_Mobilprog_feleves.ClientPage"
             Title="Saját Eszközök"
             x:Name="ClientPageRoot">

    <VerticalStackLayout Padding="16" Spacing="14">

        <Label Text="Eszközök áttekintése"
               FontAttributes="Bold"
               FontSize="20"
               HorizontalOptions="Center"
               Margin="0, 10, 0, 0"/>

        <CollectionView ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectedDevice}"
                        SelectionMode="None" 
                        VerticalOptions="FillAndExpand">

            <CollectionView.Header>
                <Label Text="Kérem válasszon ki egy eszközt a részletekhez:" Opacity="0.8" Margin="0, 0, 0, 8"/>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:Device">
                    <Frame Padding="10" 
                           BorderColor="#dddddd" 
                           Margin="0,0,0,8" 
                           HasShadow="False">

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                            <Label Grid.Row="0" 
                                   Grid.Column="0" 
                                   Text="{Binding Name}" 
                                   FontAttributes="Bold"/>

                            <Label Grid.Row="1" 
                                   Grid.Column="0" 
                                   Text="{Binding Type}" 
                                   Opacity="0.7"/>

                            <Button Grid.RowSpan="2" 
                                    Grid.Column="1" 
                                    Text="Részletek megtekintése"
                                    FontSize="12"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Padding="10, 4"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewDeviceDetailsCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>