<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ctOS_Sec_H1SFAO_Mobilprog_feleves.AdminPage"
             Title="Admin – Kliensek">
    <VerticalStackLayout Padding="16" Spacing="12">

        <HorizontalStackLayout Spacing="12">
            <Button Text="Betöltés"
                    Command="{Binding LoadClientsCommand}" />
            <Button Text="Új kliens"
                    Command="{Binding AddNewClientCommand}" />
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding Clients}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedClient}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Email}"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Address}"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Id}"/>
                        
                        <Button Grid.RowSpan="2" Grid.Column="2" Text="Delete"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteClientCommand}" />
                        <Button Grid.RowSpan="2" Grid.Column="2" Text="Edit" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteClientCommand}" />
                        <Button Grid.RowSpan="2" Grid.Column="2" Text="Check Details" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteClientCommand}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>