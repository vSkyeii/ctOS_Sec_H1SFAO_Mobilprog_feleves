<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ctOS_Sec_H1SFAO_Mobilprog_feleves"
             x:Class="ctOS_Sec_H1SFAO_Mobilprog_feleves.MainPage">
    <VerticalStackLayout>
        <VerticalStackLayout>
            <Label Text="Login"  FontSize="36" HorizontalTextAlignment="Center" FontAttributes="Bold"></Label>
            <Entry x:Name="username_entry" Placeholder="Username" Margin="100,10"></Entry>
            <Entry x:Name="password_entry" Placeholder="Password" IsPassword="True" Margin="100,10"></Entry>
            <Button Text="Login" Clicked="login_try" Margin="100,40"></Button>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentPage>
